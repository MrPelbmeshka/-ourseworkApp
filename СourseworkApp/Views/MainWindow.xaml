<Window x:Class="СourseworkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:СourseworkApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Canvas>

        <Border Canvas.Left="10" Canvas.Top="10" 
                Width="1060" Height="50" 
                Background="#2C3E50" CornerRadius="8">
            <TextBlock Text="Визуализация операций поиска и удаления в отсортированном массиве" 
                       FontSize="18" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!--ПАНЕЛЬ УПРАВЛЕНИЯ МАССИВОМ-->
        <Border Canvas.Left="10" Canvas.Top="70" 
                Width="1060" Height="60" 
                Background="White" CornerRadius="8">
            <Canvas>
                <TextBlock Canvas.Left="15" Canvas.Top="20" 
                           Text="Размер массива:" FontSize="14" VerticalAlignment="Center"/>

                <TextBox x:Name="SizeTextBox" 
                         Canvas.Left="130" Canvas.Top="12" 
                         Width="60" Height="30" 
                         Text="8" TextAlignment="Center"/>

                <Button x:Name="GenerateButton" 
                        Canvas.Left="210" Canvas.Top="10" 
                        Content="🎲 Сгенерировать случайный" 
                        Style="{StaticResource PrimaryButton}" 
                        Background="#3498DB"
                        Click="GenerateButton_Click"/>

                <Button x:Name="SortButton" 
                        Canvas.Left="430" Canvas.Top="10" 
                        Content="📊 Сортировать" 
                        Style="{StaticResource PrimaryButton}" 
                        Background="#27AE60"
                        Click="SortButton_Click"/>
            </Canvas>
        </Border>

        <!-- ОТОБРАЖЕНИЕ МАССИВА -->
        <Border Canvas.Left="10" Canvas.Top="140" 
                Width="1060" Height="140" 
                Background="White" CornerRadius="8">
            <Canvas>
                <TextBlock Canvas.Left="15" Canvas.Top="10" 
                           Text="Текущий массив" FontSize="16" FontWeight="Bold"/>

                <ScrollViewer Canvas.Left="10" Canvas.Top="35" 
                              Width="1040" Height="90" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ArrayItemsControl" 
                                  ItemsSource="{Binding ArrayItems}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="60" Height="70" 
                                        CornerRadius="6" Margin="4" 
                                        BorderThickness="1" BorderBrush="#BDC3C7"
                                        Background="{Binding BackgroundColor}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Value}" 
                                                   FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Index}" 
                                                   FontSize="11" Foreground="#7F8C8D"
                                                   HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Canvas>
        </Border>

        <!-- ПАНЕЛЬ ОПЕРАЦИЙ-->
        <Border Canvas.Left="10" Canvas.Top="290" 
                Width="1060" Height="220" 
                Background="White" CornerRadius="8">
            <Canvas>
                <TextBlock Canvas.Left="15" Canvas.Top="10" 
                           Text="Операциbи" FontSize="16" FontWeight="Bold"/>

                <!-- Блок поиска -->
                <Border Canvas.Left="15" Canvas.Top="40" 
                        Width="500" Height="100" 
                        Background="#E8F4FD" CornerRadius="8">
                    <Canvas>
                        <TextBlock Canvas.Left="15" Canvas.Top="10" 
                                   Text="🔎 Бинарный поиск" FontSize="14" FontWeight="Bold"/>

                        <TextBlock Canvas.Left="15" Canvas.Top="40" 
                                   Text="Искомое значение:" FontSize="13"/>

                        <TextBox x:Name="SearchTextBox" 
                                 Canvas.Left="150" Canvas.Top="35" 
                                 Width="80" Height="30" Text="0" TextAlignment="Center"/>

                        <Button x:Name="SearchButton" 
                                Canvas.Left="250" Canvas.Top="30" 
                                Width="100" Height="35"
                                Content="Найти" 
                                Style="{StaticResource PrimaryButton}" 
                                Background="#3498DB"
                                Click="SearchButton_Click"/>
                    </Canvas>
                </Border>

                <!-- Блок удаления -->
                <Border Canvas.Left="545" Canvas.Top="40" 
                        Width="500" Height="100" 
                        Background="#FDE8E8" CornerRadius="8">
                    <Canvas>
                        <TextBlock Canvas.Left="15" Canvas.Top="10" 
                                   Text="🗑️ Удаление по значению" FontSize="14" FontWeight="Bold"/>

                        <TextBlock Canvas.Left="15" Canvas.Top="40" 
                                   Text="Значение для удаления:" FontSize="13"/>

                        <TextBox x:Name="DeleteTextBox" 
                                 Canvas.Left="160" Canvas.Top="35" 
                                 Width="80" Height="30" Text="0" TextAlignment="Center"/>

                        <Button x:Name="DeleteButton" 
                                Canvas.Left="260" Canvas.Top="30" 
                                Width="100" Height="35"
                                Content="Удалить" 
                                Style="{StaticResource PrimaryButton}" 
                                Background="#E74C3C"
                                Click="DeleteButton_Click"/>
                    </Canvas>
                </Border>

                <!-- Информация о шагах -->
                <Border Canvas.Left="15" Canvas.Top="155" 
                        Width="1030" Height="50" 
                        Background="#F8F9FA" CornerRadius="8">
                    <Canvas>
                        <TextBlock x:Name="StepInfoText" 
                                   Canvas.Left="15" Canvas.Top="15" 
                                   Text="Готов к работе" FontSize="13"/>

                        <Button x:Name="ResetButton" 
                                Canvas.Left="930" Canvas.Top="8" 
                                Width="80" Height="34"
                                Content="🔄 Сброс" 
                                Style="{StaticResource PrimaryButton}" 
                                Background="#7F8C8D"
                                Click="ResetButton_Click"/>
                    </Canvas>
                </Border>
            </Canvas>
        </Border>

        <!-- СТАТУС БАР -->
        <Border Canvas.Left="10" Canvas.Top="520" 
                Width="1060" Height="50" 
                Background="#2C3E50" CornerRadius="8">
            <Canvas>
                <TextBlock x:Name="StatusText" 
                           Canvas.Left="15" Canvas.Top="15" 
                           Text="✅ Готов" Foreground="White" FontSize="13"/>

                <Button x:Name="SaveButton" 
                        Canvas.Left="880" Canvas.Top="8" 
                        Width="80" Height="34"
                        Content="💾 Сохранить" 
                        Style="{StaticResource PrimaryButton}" 
                        Background="#27AE60"
                        Click="SaveButton_Click"/>

                <Button x:Name="LoadButton" 
                        Canvas.Left="965" Canvas.Top="8" 
                        Width="80" Height="34"
                        Content="Загрузить" 
                        Style="{StaticResource PrimaryButton}" 
                        Background="#27AE60"
                        Click="LoadButton_Click"/>
            </Canvas>
        </Border>

        <!-- ползунок -->
        <Border Canvas.Left="10" Canvas.Top="580" 
                Width="1060" Height="80" 
                Background="White" CornerRadius="8">
            <Canvas>
                <TextBlock Canvas.Left="15" Canvas.Top="12" 
                           Text="Скорость анимации" FontSize="13" FontWeight="SemiBold"/>

                <Slider x:Name="SpeedSlider" 
                        Canvas.Left="15" Canvas.Top="35" 
                        Width="300" 
                        Minimum="100" Maximum="1000" Value="500" 
                        TickFrequency="100" TickPlacement="BottomRight"/>

                <TextBlock x:Name="SpeedValueText" 
                           Canvas.Left="330" Canvas.Top="33" 
                           Text="500 мс" FontSize="13" FontWeight="Bold"/>
            </Canvas>
        </Border>

    </Canvas>
</Window>
